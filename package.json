{
  "name": "pocket-llm",
  "version": "0.1.0",
  "description": "On-device LLM sessions for any browser — Chrome's Prompt API, WebLLM, or wllama, picked by feature detection, smallest model first.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Yasyf Mohamedali <yasyfm@gmail.com>",
  "homepage": "https://github.com/yasyf/pocket-llm",
  "repository": "github:yasyf/pocket-llm",
  "bugs": "https://github.com/yasyf/pocket-llm/issues",
  "keywords": [
    "llm",
    "webllm",
    "wllama",
    "prompt-api",
    "webgpu",
    "wasm",
    "on-device",
    "browser"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "@wllama/wllama": "^3.5.1"
  }
}
